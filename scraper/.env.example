# Scraper service config (all optional — sensible defaults baked in).
# Copy to .env to override. The scraper holds NO database credentials.

# Min characters before a result is considered "sufficient".
SCRAPER_MIN_CONTENT_CHARS=200

# Static HTTP fetch timeout (seconds).
SCRAPER_HTTP_TIMEOUT=20

# Playwright navigation timeout (milliseconds).
SCRAPER_PLAYWRIGHT_TIMEOUT_MS=30000

# Set to false in environments without Chromium installed.
SCRAPER_PLAYWRIGHT_ENABLED=true

# Override the outbound User-Agent.
# SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; PrometheusWatcher/0.1)
