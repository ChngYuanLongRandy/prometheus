# ============================================================================
# Project Prometheus — root environment template
# Copy to .env and fill in. NEVER commit .env. Secrets live here only.
# ============================================================================

# --- Supabase Postgres (backend owns ALL database access) -------------------
# Found in Supabase: Project Settings -> Database -> Connection info.
# Prefer the Session pooler (port 5432) for a long-lived Spring Boot pool.
# JDBC URL form:
#   jdbc:postgresql://<host>:<port>/<database>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-HOST:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR-DB-PASSWORD

# --- Backend <-> Scraper (HTTP only, no shared DB) --------------------------
# URL the backend uses to reach the scraper service.
# Local (native):       http://localhost:8000
# Docker Compose:       http://scraper:8000
SCRAPER_BASE_URL=http://localhost:8000

# --- Scheduler --------------------------------------------------------------
# Daily re-scrape cron (Spring cron: sec min hour day month weekday).
# Default: 08:00 every day.
WATCHER_CRON=0 0 8 * * *

# --- Frontend ---------------------------------------------------------------
# Base URL of the Spring Boot API the React app talks to.
# The frontend NEVER talks to Supabase or AWS directly.
VITE_API_BASE_URL=http://localhost:8080

# --- AWS (A2: Polly TTS + S3 audio storage) ---------------------------------
# IAM user: prometheus-tts (least-privilege: polly:Synthesize* + s3 on audio bucket only)
# Create in IAM -> Users -> Security credentials -> Create access key
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-southeast-1
# S3 bucket name (private, all public access blocked). Bucket must exist.
AWS_S3_AUDIO_BUCKET=your-prometheus-audio-bucket-name
# Optional overrides (defaults shown):
# AWS_AUDIO_URL_EXPIRY_HOURS=1
# AUDIO_CLEANUP_DAYS=30
